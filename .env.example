# --- shared ---
SEPOLIA_RPC_URL=            # your Sepolia JSON-RPC endpoint (own node or provider)
TOKEN_ADDRESS=              # ERC20 contract on Sepolia to index (e.g. Sepolia LINK)

# --- service/ ---
DATABASE_URL=postgres://fraud:fraud@localhost:5432/fraud?sslmode=disable
START_BLOCKS_BACK=50000     # first run indexes head-N .. head
WORKERS=8                   # concurrent eth_getLogs range fetchers
LISTEN=:8080
SANCTIONS_FILE=service/testdata/sanctions.json

# --- contracts/ (Foundry deploy) ---
DEPLOYER_PRIVATE_KEY=       # 0x-prefixed, funded with Sepolia ETH
FORWARDER_ADDRESS=0x15fC6ae953E024d975e77382eEeC56A9101f9F88   # Sepolia MockKeystoneForwarder (simulation)
# production KeystoneForwarder on Sepolia: 0xF8344CFd5c43616a4366C34E3EEE75af79a74482

# --- workflow/ (CRE; copy relevant lines into workflow/.env) ---
CRE_ETH_PRIVATE_KEY=        # 64 hex chars, NO 0x prefix (CRE CLI requirement)
FRAUD_REGISTRY_ADDRESS=     # filled after Foundry deploy
